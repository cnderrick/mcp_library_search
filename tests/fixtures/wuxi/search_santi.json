700001":66},"author":{"三体宇宙":4,"李淼":2,"丁永康":1,"吴雄胜":1,"刘慈欣":33,"顾仲安":4,"齐锐":2,"张生会":11,"关正文":1,"八路":1,"于天存":1},"publisher":{"中信出版集团股份有限公司":2,"四川少年儿童出版社":2,"万卷出版有限责任公司":1,"作家出版社有限公司":1,"北京科学技术出版社":1,"山东文艺出版社":1,"重庆出版社":1},"subject":{"幻想小说":4,"小说集":3,"字帖":2,"漫画":2,"短篇小说":2,"连环画":2,"刘慈欣":1,"小说研究":1,"散文集":1,"科学知识":1},"resourceType":{"1":66},"locationId":{"242":16,"143":5,"12":5,"112":8,"48":17,"116":11,"29":20,"139":4,"80":6,"118":5,"61":10},"countryCode":{"CN":66},"kindNo":{"I206.7":1,"G8":11,"I247.5":6,"H36":1,"I207.425":4,"I267":1,"J228.2":3,"O4-49":2,"I247.55":19,"I247.7":7,"I287.45":1},"docCode":{"1":66},"customSub":{}},"hlResult":{"360510":{"title":["<font color='#ff9933'>三体</font>. II. 1版"]},"477166":{"adstract":["“地球往事”<font color='#ff9933'>三</font>部曲之一"],"title":["<font color='#ff9933'>三体</font>"]},"157103":{"adstract":["本书为中国当代科学幻想小说。讲述了：在<font color='#ff9933'>三体</font>星系的外星文明对太阳系发起入侵后，人类利用宇宙社会的黑暗森林原理，以可能导致两个文明同归于尽的宇宙坐标广播为威胁，在两个文明间建立了岌岌可危的战略平衡。掌握威摄控制的人被称为执剑人。在第一任执剑人罗辑老去，新的执剑人任意接替威摄控制后，<font color='#ff9933'>三体</font>文明突然对地球发起进攻。任意缺乏决断力，没能及时启动坐标广播，至使<font color='#ff9933'>三体</font>文明迅速占领地球。人类的远航飞船不得不飞向银河深处，文明的种子开始在新世界发芽。"],"title":["<font color='#ff9933'>三体</font>. Ⅲ. Ⅲ, 死神永生, Dead end"]},"764431":{"adstract":["故事紧接上一部的剧情，讲述了<font color='#ff9933'>三体</font>人准备入侵地球这四百年间的事情。为了代替被智子锁死已经无法进步的科技前端，地球人提出了“面壁计划”。四个来自不同国家，不同种族的人类被推上了峰尖浪口，他们被赋予了最大的权限以及一切犯罪行为的豁免权，这一切只为了欺骗那个比地球科技领先百余倍的外星文明，获得四百年后末日之战的胜利。然而，在智子的协助下，反地球组织ETO一一破解了面壁者们的计划。最后一位幸存的面壁者罗辑在叶文洁的提示下，无意中了解到宇宙文明的真相。于是他以此为条件，与<font color='#ff9933'>三体</font>人展开了谈判。末日之战就此拉开帷幕。"],"title":["<font color='#ff9933'>三体</font>. Ⅱ, 黑暗森林 : 典藏版"]},"844935":{"title":["<font color='#ff9933'>三体</font> : 新版"]},"690102":{"adstract":["“地球往事”<font color='#ff9933'>三</font>部曲之一"],"title":["<font color='#ff9933'>三体</font>"]},"844049":{"title":["<font color='#ff9933'>三体</font> : 新版. 黑暗森林"]},"764039":{"adstract":["在<font color='#ff9933'>三体</font>星系的外星文明对太阳系发起入侵后，人类在两个文明间建立了岌岌可危的战略平衡。但没过多久，<font color='#ff9933'>三体</font>文明突然对地球发起进攻，并迅速占领了地球。人类的远航飞船不得不飞向银河深处，文明的种子开始在新世界发芽。"],"title":["<font color='#ff9933'>三体</font>. Ⅲ, 死神永生 : 典藏版"]},"360511":{"title":["<font color='#ff9933'>三体</font>. III. 1版"]},"360512":{"title":["<font color='#ff9933'>三体</font>. 1版"]}},"levelResultList":[]}}