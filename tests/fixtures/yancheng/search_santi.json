33,"126":58,"148":43,"17":113,"29":145,"128":78,"32":34},"countryCode":{"CN":857},"kindNo":{"I512.45":22,"I247.5":11,"I247.59":8,"I267":14,"J228.2":15,"I247.55":18,"I287.8":8,"K236.042":30,"I287.45":17,"I247.7":8},"docCode":{"1":856,"19":1},"litCode":{"1":586,"2":271},"customSub":{}},"hlResult":{"540852":{"title":["<font color='#ff9933'>三</font><font color='#ff9933'>体</font> : 纪念版. 第<font color='#ff9933'>三</font>部, 死神永生"]},"193466":{"adstract":["本书讲述人类在阻止<font color='#ff9933'>三</font><font color='#ff9933'>体</font>世界占领地球、毁灭人类文明的侵略后所发生的故事。"],"title":["<font color='#ff9933'>三</font><font color='#ff9933'>体</font>. Ⅲ. Ⅲ, 死神永生, Dead end"]},"540843":{"title":["<font color='#ff9933'>三</font><font color='#ff9933'>体</font> : 纪念版. 第一部"]},"671583":{"adstract":["本书改编自科幻巨著《<font color='#ff9933'>三</font><font color='#ff9933'>体</font>》, 讲述了地球人类文明和<font color='#ff9933'>三</font><font color='#ff9933'>体</font>文明的信息交流、生死搏杀及两个文明在宇宙中的兴衰历程。"],"title":["<font color='#ff9933'>三</font><font color='#ff9933'>体</font> : 图像小说"]},"723349":{"adstract":["本书为《<font color='#ff9933'>三</font><font color='#ff9933'>体</font>》系列最终卷, 讲述了在<font color='#ff9933'>三</font><font color='#ff9933'>体</font>星系的外星文明对太阳系发起入侵后, 人类利用宇宙社会的黑暗森林原理, 以可能导致两个文明同归于尽的宇宙坐标广播为威胁, 在两个文明间建立了岌岌可危的战略平衡。掌握威慑控制的人被称为执剑人。在第一任执剑人罗辑老去, 新的执剑人程心接替威慑控制后, <font color='#ff9933'>三</font><font color='#ff9933'>体</font>文明突然对地球发起进攻。程心缺乏决断力, 没能及时启动坐标广播, 致使<font color='#ff9933'>三</font><font color='#ff9933'>体</font>文明迅速占领地球。人类的远航飞船不得不飞向银河深处, 文明的种子开始在新世界发芽。"],"title":["<font color='#ff9933'>三</font><font color='#ff9933'>体</font>. 死神永生 : 图文版"]},"540844":{"title":["<font color='#ff9933'>三</font><font color='#ff9933'>体</font> : 纪念版. 第二部, 黑暗森林"]},"627241":{"title":["<font color='#ff9933'>三</font><font color='#ff9933'>体</font> : 新版. 黑暗森林"]},"627176":{"title":["<font color='#ff9933'>三</font><font color='#ff9933'>体</font> : 新版"]},"363285":{"title":["<font color='#ff9933'>三</font><font color='#ff9933'>体</font> : 典藏版"]},"574281":{"adstract":["本书讲述了：“文化大革命”如火如荼进行的同时，军方探寻外星文明的绝密计划“红岸工程”取得了突破性进展。但无人料到，地球文明向宇宙发出的第一声啼鸣彻底改变了人类的命运。四光年外，为了生存挣扎的“<font color='#ff9933'>三</font><font color='#ff9933'>体</font>文明”接收到了地球发来的信息。在运用超技术锁死地球人的基础科学之后，<font color='#ff9933'>三</font><font color='#ff9933'>体</font>人庞大的宇宙舰队开始向地球进发。"],"title":["<font color='#ff9933'>三</font><font color='#ff9933'>体</font> : 图文版"]}},"levelResultList":[]}}