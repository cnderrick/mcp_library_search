{"success":true,"message":"操作成功","errCode":200,"errorCode":null,"data":{"numFound":427,"searchResult":[{"recordId":281453,"favoritesId":null,"kbcId":null,"title":"活着","collectionName":null,"langCode":"chi","countryCode":"CN","subjects":null,"author":"余华著","publisher":"北京十月文艺出版社","isbn":"978-7-5302-1559-3","isbns":["978-7-5302-1559-3"],"issn":"978-7-5302-1559-3","publishYear":"2017","publFreqCode":null,"adstract":"《活着》是余华的长篇代表作之一，最早发表于《收获》1992年第6期。小说写“我”去乡间收集民间歌谣，遇到一位叫福贵的老人，他向我讲述了自己坎坷的一生：年轻时赌光家业，从地主少爷变得一贫如洗；在为母亲求医路上被国民党部队抓了壮丁，被解放军俘虏后回到家里女儿已经变成哑巴；家人终于团聚，妻子、儿子、女儿、外孙却又因为各种意外相继离世……他经历了一生的苦难，却没有丝毫抱怨，而依然友好地对待这个世界，依然乐观地活着。余华说这是一部讲述“一个人和他的命运之间的友情”的书。小说出版之后引起很大反响，先后被翻译成多国语言，荣获意大利格林扎纳·卡佛文学奖最高奖项，入选香港《亚洲周刊》评选的“20世纪中文小说百年百强”、中国百位批评家和文学编辑评选的“20世纪90年代最有影响的10部作品”等。","ddAbstract":null,"subjectWord":"长篇小说","chiClassNo":["I247.57"],"sciClassNo":null,"periName":null,"vol":null,"issue":null,"year":null,"keyWord":null,"claimStatus":null,"_46":null,"ddGroup":null,"ddType":null,"ddYear":null,"needVerify":null,"verifyStatus":null,"physicalCount":20,"groupPhysicalCount":20,"contiCount":0,"groupContiCount":null,"groupECount":0,"groupDCount":null,"esCount":0,"eCount":0,"dCount":0,"discode1":["05"],"discode2":["0501"],"discode3":["050105","050106"],"_47Unit":["余华,"],"_48Unit":["余华著"],"hostUnit":",余华,","docCode":1,"callNoOne":"I247.57/257","pubPlace":"北京","callNo":["I247.57/257","I247.59/158=5"],"onShelfCountI":7,"multiVersionNum":null,"canBrrowCountI":null,"groupRecord":"[{\"recordId\":281453,\"mdLevel\":3}]","groupRecordIds":[{"recordId":281453,"mdLevel":3}],"price":"35.00","bookPage":"216页","bookThickness":"21cm","_021":["1960-","余华,"],"personalAuthor":"1960-,余华,","_022":null,"organizedAuthor":null,"uniformBookNo":null,"postNo":null,"bgnEndVol":null,"bgnEndVols":null,"publFreq":null,"publFreqDoc":null,"npcClassNo":null,"pagesNum":null,"group":null,"tutor":null,"tutorGroup":null,"chiSubjectClass":["文学-社会、言情小说"],"avgScore":null,"doi":null,"beginDate":null,"endDate":null,"docName":"图书","coreInclu