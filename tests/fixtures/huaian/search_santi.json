untryCode":{"CN":3110},"kindNo":{"I207":43,"I512.45":118,"H125.4":53,"K236":81,"K20":45,"I247.5":114,"I267":47,"I512":51,"I247.55":57,"K236.042":57,"I287.45":45},"docCode":{"1":3110},"customSub":{}},"hlResult":{"2063196":{"adstract":["“地球往事”<font color='#ff9933'>三</font>部曲之一"],"title":["<font color='#ff9933'>三</font><font color='#ff9933'>体</font>"]},"681771":{"title":["<font color='#ff9933'>三</font><font color='#ff9933'>体</font>. Ⅱ, 黑暗森林"]},"864208":{"adstract":["《<font color='#ff9933'>三</font><font color='#ff9933'>体</font>》讲述了一个关于生存和死亡；死亡，忠诚和背叛的故事。作者试图以光年为尺度重新演绎一个文明数百次毁灭和重生的传奇。该作分8期在《科幻世界》连载，深受好评，荣获2006年度\"银河奖\"。"],"title":["<font color='#ff9933'>三</font><font color='#ff9933'>体</font>"]},"2112545":{"adstract":["\"地球往事\"<font color='#ff9933'>三</font>部曲之一"],"title":["<font color='#ff9933'>三</font><font color='#ff9933'>体</font>"]},"733596":{"adstract":["本书改编自科幻文学《<font color='#ff9933'>三</font><font color='#ff9933'>体</font>》。原著作品讲述了地球人类文明和<font color='#ff9933'>三</font><font color='#ff9933'>体</font>文明的信息交流、生死搏杀及两个文明在宇宙中的兴衰历程。本书主要讲述了原著第一部的内容--四光年外，为了生存挣扎的\"<font color='#ff9933'>三</font><font color='#ff9933'>体</font>文明\"接收到了地球发来的信息。在运用超技术锁死地球人的基础科学之后，<font color='#ff9933'>三</font><font color='#ff9933'>体</font>人庞大的宇宙舰队开始向地球进发……。"],"title":["<font color='#ff9933'>三</font><font color='#ff9933'>体</font> : 图像小说"]},"416589":{"adstract":["在<font color='#ff9933'>三</font><font color='#ff9933'>体</font>星系的外星文明对太阳系发起入侵后，人类在两个文明间建立了岌岌可危的战略平衡。但没过多久，<font color='#ff9933'>三</font><font color='#ff9933'>体</font>文明突然对地球发起进攻，并迅速占领了地球。人类的远航飞船不得不飞向银河深处，文明的种子开始在新世界发芽。"],"title":["<font color='#ff9933'>三</font><font color='#ff9933'>体</font>. Ⅲ, 死神永生 : 典藏版"]},"917937":{"adstract":["在<font color='#ff9933'>三</font><font color='#ff9933'>体</font>星系的外星文明对太阳系发起入侵后，人类在两个文明间建立了岌岌可危的战略平衡。但没过多久，<font color='#ff9933'>三</font><font color='#ff9933'>体</font>文明突然对地球发起进攻，并迅速占领了地球。人类的远航飞船不得不飞向银河深处，文明的种子开始在新世界发芽。"],"title":["<font color='#ff9933'>三</font><font color='#ff9933'>体</font>. Ⅲ, 死神永生 : 典藏版"]},"2027942":{"title":["<font color='#ff9933'>三</font><font color='#ff9933'>体</font>"]},"917938":{"adstract":["故事紧接上一部的剧情，讲述了<font color='#ff9933'>三</font><font color='#ff9933'>体</font>人准备入侵地球这四百年间的事情。为了代替被智子锁死已经无法进步的科技前端，地球人提出了“面壁计划”。四个来自不同国家，不同种族的人类被推上了峰尖浪口，他们被赋予了最大的权限以及一切犯罪行为的豁免权，这一切只为了欺骗那个比地球科技领先百余倍的外星文明，获得四百年后末日之战的胜利。然而，在智子的协助下，反地球组织ETO一一破解了面壁者们的计划。最后一位幸存的面壁者罗辑在叶文洁的提示下，无意中了解到宇宙文明的真相。于是他以此为条件，与<font color='#ff9933'>三</font><font color='#ff9933'>体</font>人展开了谈判。末日之战就此拉开帷幕。"],"title":["<font color='#ff9933'>三</font><font color='#ff9933'>体</font>. Ⅱ, 黑暗森林 : 典藏版"]},"2027943":{"title":["<font color='#ff9933'>三</font><font color='#ff9933'>体</font>"]}}}}